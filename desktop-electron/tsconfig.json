{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": [
    "*.ts",
    "tunnel/*.ts",
    "generated/*.json",
    "../src/app/desktop/types.ts",
    "../src/app/collab/relay/protocol.ts",
    "../src/app/collab/tunnel/credential.ts"
  ]
}
