{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "desktop/target/**",
    "**/dist/**",
    "**/node_modules/**",
    "packages/react/vitest.workspace.ts"
  ],
  "ignoreWorkspaces": ["packages/demos"],
  "ignoreUnresolved": [
    "/src/app/editor/fonts/index.ts",
    "#core/*"
  ],
  "ignoreDependencies": [
    "vue/compiler-sfc"
  ],
  "ignoreBinaries": ["figma-use", "identify", "magick", "open", "osascript"]
}
