{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "#react/*": [
        "./packages/react/src/*",
        "./packages/react/src/*.tsx"
      ],
      "#core/*": [
        "./packages/core/src/*"
      ],
      "#cli/*": [
        "./packages/cli/src/*"
      ],
      "#mcp/*": [
        "./packages/mcp/src/*"
      ],
      "#dom-css/*": [
        "./packages/dom-css/src/*"
      ],
      "#tests/*": [
        "./tests/*"
      ],
      "@openweave/react": [
        "./packages/react/src/index.ts"
      ],
      "@openweave/core": [
        "./packages/core/src/index.ts"
      ],
      "@openweave/core/*": [
        "./packages/core/src/*"
      ],
      "@openweave/dom-css": [
        "./packages/dom-css/src/index.ts"
      ],
      "#scene-graph/*": [
        "./packages/scene-graph/src/*"
      ],
      "@openweave/scene-graph": [
        "./packages/scene-graph/src/index.ts"
      ],
      "@openweave/scene-graph/*": [
        "./packages/scene-graph/src/*"
      ],
      "#pen/*": [
        "./packages/pen/src/*"
      ],
      "@openweave/pen": [
        "./packages/pen/src/index.ts"
      ],
      "@openweave/pen/*": [
        "./packages/pen/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
